	(text "Cell 1: A + = red, B + = green" (exclude_from_sim no) (at 38.96 96.52 0) (effects (font (size 1.6 1.6)) (justify left top)) (uuid "5c79e0ac-8f7b-4957-af7e-6bdb9af7a198"))
	(text "Cell 2: B + = red, C + = green" (exclude_from_sim no) (at 115.16 96.52 0) (effects (font (size 1.6 1.6)) (justify left top)) (uuid "ea1247b6-bbda-4cfc-a530-6680568ad7e1"))
	(text "Cell 3: C + = red, A + = green" (exclude_from_sim no) (at 191.36 96.52 0) (effects (font (size 1.6 1.6)) (justify left top)) (uuid "357b8056-cbff-4d6d-a38a-33af2ddf390a"))
	(text "H1 / H2: M2 mounting holes, one on each short side of the 20 x 10 mm board." (exclude_from_sim no) (at 210 142 0) (effects (font (size 1.6 1.6)) (justify left top)) (uuid "a6725098-93f9-456d-b34e-67279c760d6c"))
	(text "Wire pads A / B / C: thin wires to the charger board pads TP13 (A), TP14 (B), TP15 (C).\nCharger side drives PA1 = A, PA3 = B, PA0 = C through 100R each (R27-R29) and scans one line + per ms.\nCell 1 LED between A-B, cell 2 between B-C, cell 3 between C-A (the same order as the firmware).\nLED: Kingbright KPHBM-2012SURKCGKC (LCSC C598341), 2.0 x 1.25 mm, red 1.95 V / yellow-green 2.1 V.\nDatasheet pinout: red = anode 1, cathode 2; green = anode 4, cathode 3 -> pins 1+3 to the first line,\npins 2+4 to the second line. Two LEDs in series need ~4 V > 3.3 V, so no LED lights by accident." (exclude_from_sim no) (at 20 150 0) (effects (font (size 1.6 1.6)) (justify left top)) (uuid "9ee2bb9f-2187-4a72-862f-8f7efc6aa535"))
